# =============================================================
#  .env.example  -  EXAMPLE configuration
#
#  How to use:
#    1. Copy this file and rename it to ".env"
#    2. Fill in real values (keys from sponsor dashboards)
#    3. Never commit ".env" to GitHub
# =============================================================


# --- AI Provider (via Meterless Nightshift -> NVIDIA Nemotron) ----
# IMPORTANT: NVIDIA API key is NOT stored in this project.
#   1. Create an NVIDIA API key at https://build.nvidia.com/models
#   2. Enter it in Nightshift desktop app -> Providers -> NVIDIA -> Save
#   3. Copy Runtime URL + token from Nightshift Console
#   4. Fill in below (Nightshift routes to NVIDIA Nemotron)
MODEL_BASE_URL=http://localhost:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=meterless/auto

# Alternative: direct providers (OpenAI/Gemini/Groq) - optional
# GROQ_API_KEY=
# GEMINI_API_KEY=

# --- Sponsor hackathon ----------------------------------------
# Zetaris   - data federation across sources (API key from Zetaris web UI)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift - server runs only when needed
METERLESS_KEY=your-nightshift-runtime-token

# --- Server ---------------------------------------------------
PORT=8080
AGENT_SHARED_TOKEN=generate-a-long-agent-token

# --- Database -------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=presensi
DB_USER=root
DB_PASS=