# =============================================================
#  .env.example  -  CONTOH isi konfigurasi
#
#  Cara pakai:
#    1. Salin file ini, ganti nama jadi ".env"
#    2. Isi nilai aslinya (key dari sponsor/dashboard)
#    3. File ".env" JANGAN pernah di-commit ke GitHub
#
#  File ini (yang kosong) AMAN di-commit: isinya cuma nama
#  variabel, tanpa kunci. Juri bisa lihat "oh, pakai sponsor
#  ini-itu" tanpa bisa menyalahgunakannya.
# =============================================================

# --- Otak agent (boleh isi >1 untuk fallback otomatis) --------
# NVIDIA Nemotron  - https://build.nvidia.com   (sponsor, gratis)
NVIDIA_API_KEY=

# Groq             - https://console.groq.com   (free tier)
GROQ_API_KEY=

# Google Gemini    - https://aistudio.google.com (free tier)
GEMINI_API_KEY=

# xAI Grok         - https://x.ai               (sponsor)
XAI_API_KEY=

# --- Sponsor hackathon ----------------------------------------
# Zetaris   - federasi data lintas sumber
ZETARIS_TOKEN=

# Meterless - server nyala hanya saat dibutuhkan
METERLESS_KEY=

# --- Server ---------------------------------------------------
PORT=8080

# Internal PHP <-> Node agent authentication. Generate a long random value.
AGENT_SHARED_TOKEN=
