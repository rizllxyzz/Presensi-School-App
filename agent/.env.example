# Agent environment. Copy this file to .env and fill in what you have.
# H-MEM is vendored under vendor/hmem and runs locally without an API key.
# Nothing here is required: H-MEM and the retrieval-only answer path run
# fully offline. A key only upgrades how answers are phrased and how well
# the agent loop can critique its own evidence.

# NVIDIA Nemotron (hackathon sponsor) - OpenAI-compatible, https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Nightshift/Meterless runtime. When set, this takes priority and can serve Nemotron.
# Example local OpenAI-compatible endpoint: http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Groq (free tier) - OpenAI-compatible, fast. Get a key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini - https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Zetaris (hackathon sponsor, required in every submission).
# The TypeScript agent uses this token for the configured Zetaris REST integration.
ZETARIS_TOKEN=

# Required when the agent is reachable by the PHP application.
AGENT_SHARED_TOKEN=
